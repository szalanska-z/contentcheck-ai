{
  "name": "contentcheck-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:auth-schema": "better-auth generate --config server/auth/schema-config.ts --adapter drizzle --dialect postgresql --output server/db/auth-schema.ts --yes",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.27",
    "@lucide/vue": "^1.0.0",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.0.0",
    "parse5": "^8.1.1",
    "pg": "^8.23.1",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@nuxt/eslint": "^1.0.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.27",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.0.0"
  }
}
