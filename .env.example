# Copy to .env. Use the pooled connection string from your Neon development branch.
DATABASE_URL=
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Production email verification and password recovery.
AUTH_ENABLE_PUBLIC_SIGNUP=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Demo uses a built-in example and needs no OpenAI credentials.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=
NUXT_AI_MODE=demo
NUXT_AI_ALLOW_PRODUCTION_LIVE=false
